{
  "manifest_version": 3,
  "name": "Odina",
  "version": "0.1.0",
  "description": "__MSG_description__",
  "default_locale": "ar",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "context-menu@odina.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
